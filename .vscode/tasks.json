{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Pull Files to .src",
            "type": "shell",
            "command": "sudo ./pull_files.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Install Files from .src",
            "type": "shell",
            "command": "sudo ./install_files.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "icon": {
                "id": "cloud-upload",
                "color": "terminal.ansiRed"
            },
            "problemMatcher": []
        },
        {
            "label": "Strip Passwords",
            "type": "process",
            "command": "python3",
            "args": ["./strip_passwords.py"],
            "problemMatcher": []
        }
    ]
}